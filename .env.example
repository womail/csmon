# Copy to .env.local for `pnpm dev` / `pnpm start`. Docker Compose reads the same names.

# SQLite directory. Defaults to ./data
# CSMON_DATA_DIR=/app/data

# Optional shared secret. When set, /api/* (except /api/health and /api/session) require
# Authorization: Bearer <token> or the HttpOnly csmon_token cookie.
# CSMON_TOKEN=

# Set to 1 behind HTTPS so the session cookie gets the Secure flag.
# CSMON_SECURE_COOKIE=1

# GitHub owner/repo when no manifest URL is set (GET /api/update)
# CSMON_UPDATE_REPO=womail/csmon

# HTTPS JSON manifest for private installs (see public/csmon-update.example.json)
# CSMON_UPDATE_MANIFEST_URL=https://csmon.example.com/csmon-update.json
# Allow Options override manifestUrl only on this domain suffix:
# CSMON_UPDATE_MANIFEST_ALLOW_SUFFIX=.example.com

# Default board item SQL limit when the client does not pass ?itemLimit=
# CSMON_ITEM_LIMIT=500
