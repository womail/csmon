# Copy to .env.local for `pnpm dev` / `pnpm start`. Docker Compose reads the same names.

# SQLite directory. Defaults to ./data
# CSMON_DATA_DIR=/app/data

# Optional shared secret. When set, /api/* (except /api/health and /api/session) require
# Authorization: Bearer <token> or the HttpOnly csmon_token cookie.
# CSMON_TOKEN=

# Set to 1 behind HTTPS so the session cookie gets the Secure flag.
# CSMON_SECURE_COOKIE=1

# GitHub owner/repo used by GET /api/update
# CSMON_UPDATE_REPO=womail/csmon
