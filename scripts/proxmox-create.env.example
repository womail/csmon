# Copy to /etc/csmon/proxmox-create.env on the Proxmox node (or export before running).
# Required for `create` when using a static IP:
# CSMON_IP=10.1.1.244/24
# CSMON_GW=10.1.1.1

# Proxmox
# CSMON_PVE_NODE=          # default: local node name
# CSMON_CTID=              # default: next free ID >= 100
# CSMON_CT_NAME=csmon
# CSMON_STORAGE=local-lvm
# CSMON_BRIDGE=vmbr0
# CSMON_TEMPLATE_STORAGE=local

# Guest size
# CSMON_MEMORY=4096
# CSMON_CORES=4
# CSMON_DISK=32
# CSMON_SWAP=512

# Network (static). Omit CSMON_IP for DHCP on vmbr0.
# CSMON_IP=10.1.1.244/24
# CSMON_GW=10.1.1.1
# CSMON_DNS=1.1.1.1

# csmon app (passed into proxmox-starter.sh on the guest)
# CSMON_GIT_REPO=https://github.com/womail/csmon.git
# CSMON_GIT_BRANCH=main
# CSMON_INSTALL_DIR=/opt/csmon

# Optional: CSMON_ROOT_PASSWORD=change-me
# Optional: CSMON_SSH_PUBKEY="ssh-ed25519 AAAA... you@host"
# CSMON_LXC_PRIVILEGED=0   # set 1 if Docker fails in unprivileged LXC
